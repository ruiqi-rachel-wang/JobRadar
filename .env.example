ADMIN_PASSWORD=
SECRET_KEY=replace-with-a-long-random-string
# Do NOT set JOBRADAR_DATA_DIR / JOBRADAR_COMPANIES_FILE to relative paths.
# The web app runs with `--chdir app` (cwd=.../jobdrop/app) but the scanner runs
# from .../jobdrop, so a relative `app/data` resolves to two DIFFERENT folders —
# the scanner writes one DB and the site reads another (empty) one. The code
# default (BASE_DIR/data) is already correct and absolute for both. Only override
# with ABSOLUTE paths, e.g. JOBRADAR_DATA_DIR=/home/ubuntu/jobdrop/app/data
JOBRADAR_ENABLE_APP_SCHEDULER=false
# Scan concurrency per lane (threads). html = requests-based page scrapes.
# JOBRADAR_API_WORKERS=24
# JOBRADAR_WORKDAY_WORKERS=4
# JOBRADAR_HTML_WORKERS=8
# JOBRADAR_BROWSER_WORKERS=2
JOBRADAR_RESPECT_ROBOTS=true
JOBRADAR_403_BACKOFF_HOURS=168
SESSION_COOKIE_SECURE=false
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Saved-search email delivery. Use an SMTP provider that supports STARTTLS.
# The final scheduled fresh scan sends one digest per enabled saved search.
JOBDROP_SMTP_HOST=
JOBDROP_SMTP_PORT=587
JOBDROP_SMTP_USER=
JOBDROP_SMTP_PASSWORD=
JOBDROP_SMTP_USE_TLS=true
JOBDROP_EMAIL_FROM=
JOBDROP_EMAIL_FROM_NAME=JobDrop
JOBDROP_PUBLIC_URL=https://jobdrop.site
