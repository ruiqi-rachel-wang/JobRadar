[Unit]
Description=JobDrop scanner (one-shot)
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/jobdrop
EnvironmentFile=/home/ubuntu/jobdrop/.env
ExecStart=/home/ubuntu/jobdrop/venv/bin/python deploy/run_scanner.py --all --full
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
